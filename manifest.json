{
  "manifest_version": 2,
  "name": "Amazon Subscription Wizard",
  "version": "1.3.0",
  "description": "Compare, migrate, and manage Amazon Subscribe & Save subscriptions across accounts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Subscription Wizard",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*subscribe*",
        "*://*.amazon.com/*auto-deliveries*",
        "*://*.amazon.com/gp/subscribe-and-save/*",
        "*://*.amazon.com/fmc/*sns*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "icons/icon48.png",
    "icons/icon128.png",
    "welcome.html"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "subscription-wizard@weirdave",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
